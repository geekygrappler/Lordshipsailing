---
layout: null
permalink: /admin/published.json
---
{
  "articles": [
    {% for post in site.posts %}
    {
      "id": "published-{{ post.slug }}",
      "title": {{ post.title | jsonify }},
      "description": {{ post.description | default: "" | jsonify }},
      "slug": {{ post.slug | jsonify }},
      "publishedUrl": {{ post.url | relative_url | jsonify }},
      "publishedAt": {{ post.date | date_to_xmlschema | jsonify }},
      "sourcePath": {{ post.path | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
